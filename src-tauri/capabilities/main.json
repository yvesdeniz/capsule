{
  "identifier": "main-ui",
  "description": "Permissions for our own React UI window (local origin)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-start-resize-dragging",
    "dialog:allow-open",
    "allow-player-snapshot",
    "allow-player-play",
    "allow-player-pause",
    "allow-player-toggle",
    "allow-player-next",
    "allow-player-previous",
    "allow-player-seek",
    "allow-player-set-volume",
    "allow-player-toggle-shuffle",
    "allow-player-cycle-repeat",
    "allow-auth-status",
    "allow-auth-show-login",
    "allow-navidrome-connect",
    "allow-navidrome-status",
    "allow-dev-load-recent",
    "allow-library-songs",
    "allow-library-albums",
    "allow-library-playlists",
    "allow-library-album-songs",
    "allow-library-search",
    "allow-library-counts",
    "allow-library-sync",
    "allow-lyrics-for",
    "allow-settings-get",
    "allow-settings-set",
    "allow-play-songs",
    "allow-play-album",
    "allow-play-playlist"
  ]
}
